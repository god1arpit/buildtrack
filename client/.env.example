# Frontend API configuration (for APK / production builds)
# Local dev: leave everything unset — the Vite proxy handles /api and /ai-api.
# APK build: set these at build time, e.g.
#   VITE_API_URL=https://buildtrack-server.onrender.com/api npm run build
#   VITE_AI_API_URL=https://buildtrack-ai.onrender.com/api npm run build
VITE_API_URL=
VITE_AI_API_URL=
