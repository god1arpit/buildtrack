PORT=5000

# REQUIRED — generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit the real value to git. Never reuse the old committed secret.
JWT_SECRET=change_this_to_a_long_random_string

# NOTE: MONGO_URI is unused — the app uses the embedded JSON datastore
# (server/data/db.json). Removed to avoid confusion.

NODE_ENV=development
